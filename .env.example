# Copy this file to .env and set DB_PASSWORD to your local PostgreSQL password.

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=vacation_db
# Used only by `npm run test:integration` (wiped on every run).
DB_NAME_TEST=vacation_db_test
DB_POOL_SIZE=10
DB_LOG_QUERIES=false

# --- Authentication ---
# Local development only. Use a long random value in any shared environment.
JWT_SECRET=local-dev-only-secret-please-change-0123456789
# Token lifetime: a number followed by s, m, h or d.
JWT_EXPIRES_IN=8h

# --- Application ---
# "Today" is computed in this timezone (vacations must start after the submission day).
APP_TIMEZONE=Asia/Jerusalem
# debug | info | warn | error | silent
LOG_LEVEL=info
